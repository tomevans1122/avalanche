# Create a CDSE OAuth client in the Copernicus Data Space Ecosystem dashboard,
# then set its values locally. Never commit a real .env file.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional alternate authentication for one-off downloads. Prefer OAuth above.
CDSE_USERNAME=
CDSE_PASSWORD=

# Optional official regional avalanche-bulletin API. The endpoint must return
# JSON and the declared region must exactly match config/pilot-study.json.
OFFICIAL_REPORT_URL=
OFFICIAL_REPORT_API_KEY=
OFFICIAL_REPORT_REGION=Mont Blanc pilot area
